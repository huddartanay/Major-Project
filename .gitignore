# Per-experiment raw JSONL is regeneratable from seeded runners and is
# already gitignored per-directory; a top-level pattern catches the same
# thing if a new experiment folder is added without its own .gitignore.
experiments/**/raw_results/*.jsonl
experiments/**/raw_results_heldout/*.jsonl
experiments/**/raw_results/manifest.csv
experiments/**/raw_results/detector_summary.json
experiments/**/raw_results/run_summary.json
